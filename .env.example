# Supabase connection. Copy to .env.local and fill in.
#
# Local development against the Docker stack (`npx supabase start`) uses the
# values printed by `npx supabase status`. The anon key is safe to expose in a
# client bundle — row-level security is what protects the data, not the key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
